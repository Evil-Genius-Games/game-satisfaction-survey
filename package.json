{
  "name": "game-satisfaction-survey",
  "version": "1.0.0",
  "description": "Game Satisfaction Survey - Typeform-like survey application for collecting game feedback and GM interest",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app lib proxy.ts --ext .ts,.tsx",
