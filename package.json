    "recharts": "^3.4.1",
    "resend": "^6.9.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.54.0",
    "eslint-config-next": "^16.1.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.3.0",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  },
  "overrides": {
    "postcss": "^8.5.10"
